# Supabase (obrigatório para login/online; VITE_* é exposto ao browser)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_ou_publishable
# Alternativa para projetos Supabase com chave nova:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional para SSR/server functions
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_ou_publishable
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_apenas_no_servidor

# Anúncios (todos OPCIONAIS — o app cai em defaults hardcoded se ausentes;
# src/lib/adManager.ts: ADSENSE_CLIENT linha 24, ADSTERRA_INVOKE_URL 26,
# MONETAG_SRC 28, MONETAG_ZONE 29). Sobrescrever SÓ com o valor do provedor.
# VITE_ADSENSE_CLIENT=ca-pub-...
# VITE_ADSTERRA_INVOKE_URL=https://.../invoke.js
# VITE_MONETAG_SRC=https://.../tag.min.js
# VITE_MONETAG_ZONE=11607595

# N8n Configuration
N8N_HOST=localhost
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here
N8N_ENCRYPTION_KEY=your_encryption_key_here_generate_with_openssl
TIMEZONE=America/Sao_Paulo
WEBHOOK_URL=http://localhost:5678/

# Cloudflare Tunnel Configuration
# Get your tunnel token from: https://dash.cloudflare.com/
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
